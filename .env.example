# MAPS_API_KEY: Required for Google Maps SDK, Routes API, Elevation API, and Places API.
# Configure this in the Secrets panel in Google AI Studio.
MAPS_API_KEY=MY_GOOGLE_MAPS_API_KEY

# OPENWEATHER_API_KEY: Required for real-time OpenWeatherMap rain & high-wind rider alerts.
# Configure this in the Secrets panel in Google AI Studio.
OPENWEATHER_API_KEY=MY_OPENWEATHER_API_KEY
